cell sa_fuel   3001 fill 2000  -11        % one fuel assembly
cell sa_graph  3001 reflector  11         % graphite out to the column boundary

lat 7000 9 0.0 0.0 1      % vertical stack
0.0  3001

%% -- CELL definition for the fuel assemblies -- %%
cell fuel_assembly          60 fill 2000 -22        
cell graph_FA               60 fill 1000 -11 22   
cell void_FA                60 void       11

%% -- CELL definition for graphite filling -- %%
cell graph       50 graphite  -55
cell col_fill 0 fill 7000  -99      % the axial stack, clipped to one hex column
cell col_out  0 outside     99

